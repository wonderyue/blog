// Portfolio sections, grid, gallery and lightbox.
// Loaded only on pages using `layout: portfolio` (see _partial/head.ejs).

$accent = #0085a1
$ink = #404040
$muted = #909090
$line = rgba(0,0,0,0.09)

.portfolio-container
  padding-right: 0 !important

// --------------------------------------------------------------- sections
.pf-section
  margin-bottom: 54px
  &:last-child
    margin-bottom: 20px

.pf-section-title
  margin: 0 0 20px !important
  padding-bottom: 9px
  border-bottom: 1px solid $line
  font-size: 15px
  font-weight: 600
  letter-spacing: .09em
  text-transform: uppercase
  color: $muted

// ------------------------------------------------------------------- grid
.pf-grid
  display: grid
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr))
  gap: 26px
  // Stretch (default) so every card in a row is the same height; the body
  // flexes and pins the link buttons to the bottom via margin-top: auto.

.pf-card
  display: flex
  flex-direction: column
  background: #fff
  border: 1px solid $line
  border-radius: 6px
  overflow: hidden
  transition: transform .22s ease, box-shadow .22s ease, opacity .22s ease
  &:hover
    transform: translateY(-4px)
    box-shadow: 0 10px 26px rgba(0,0,0,0.11)
  &:hover .pf-cover img
    transform: scale(1.045)
  &.is-featured
    grid-column: span 2


  // Reveal-on-scroll start state; cleared by portfolio.js.
  &.pf-reveal
    opacity: 0
    transform: translateY(14px)
  &.pf-reveal.is-in
    opacity: 1
    transform: none

// NOTE: keep the nested `img` rule directly under .pf-cover. Stylus nests by
// indentation, so inserting another top-level selector above it silently
// re-parents it and every cover loses its positioning.
.pf-cover
  position: relative
  padding-bottom: 56.25% // 16:9 -- crops every cover to one consistent shape
  background: #f2f2f2
  overflow: hidden
  img
    position: absolute
    top: 0
    left: 0
    width: 100%
    height: 100%
    margin: 0 // the theme puts a 24px margin on every img; it shifts this one
    object-fit: cover
    transition: transform .35s ease

// Placeholder for a cover that has not been added yet, so a missing file
// reads as "pending" instead of a broken-image icon.
.pf-cover-fallback
  position: absolute
  top: 50%
  left: 0
  width: 100%
  transform: translateY(-50%)
  text-align: center
  padding: 0 14px
  font-size: 13px
  letter-spacing: .04em
  text-transform: uppercase
  color: #b4b4b4

// Corner flag for unreleased / notable work.
.pf-badge
  position: absolute
  top: 10px
  left: 10px
  z-index: 2
  font-size: 11.5px
  letter-spacing: .04em
  text-transform: uppercase
  color: #fff
  background: rgba(12,12,12,0.78)
  border-radius: 3px
  padding: 4px 9px
  pointer-events: none

// Invisible click target over the cover -- opens the lightbox.
.pf-zoom
  position: absolute
  top: 0
  left: 0
  width: 100%
  height: 100%
  border: 0
  padding: 0
  background: transparent
  cursor: zoom-in
  &:focus-visible
    outline: 2px solid $accent
    outline-offset: -4px

.pf-body
  padding: 16px 18px 18px
  display: flex
  flex-direction: column
  flex: 1 1 auto

.pf-title
  margin: 0 0 6px !important
  font-size: 18px
  font-weight: 600
  color: $ink

.pf-summary
  margin: 0
  font-size: 14px
  line-height: 1.55
  color: $muted
  // Cap summaries at two lines so card bodies stay a uniform height.
  display: -webkit-box
  -webkit-line-clamp: 2
  -webkit-box-orient: vertical
  overflow: hidden

.pf-tags
  list-style: none
  padding: 0
  margin: 12px 0 4px
  display: flex
  flex-wrap: wrap
  gap: 6px
  li
    font-size: 11.5px
    letter-spacing: .03em
    text-transform: uppercase
    color: $muted
    border: 1px solid $line
    border-radius: 3px
    padding: 3px 7px

.pf-links
  margin-top: auto // pins the buttons to the card bottom so rows line up
  padding-top: 13px
  border-top: 1px solid $line
  display: flex
  flex-wrap: wrap
  gap: 8px

.pf-link
  font-size: 13.5px
  color: $accent !important
  text-decoration: none !important
  border: 1px solid rgba(0,133,161,0.35)
  border-radius: 4px
  padding: 5px 11px
  transition: background-color .18s ease, color .18s ease
  &:hover
    background: $accent
    color: #fff !important

// ------------------------------------------------------- gallery (artwork)
// Masonry columns. Artwork keeps its own proportions -- no fixed-ratio box,
// so nothing is cropped and no image floats in an oversized cell.
.pf-gallery
  column-count: 3
  column-gap: 18px
  margin-top: 4px

.pf-shot
  break-inside: avoid
  page-break-inside: avoid // Safari still wants the old name
  margin: 0 0 18px
  display: inline-block
  width: 100%

.pf-shot-btn
  display: block
  width: 100%
  padding: 0
  border: 1px solid $line
  border-radius: 4px
  overflow: hidden
  background: #f7f7f7
  cursor: zoom-in
  transition: box-shadow .2s ease, border-color .2s ease
  &:hover
    border-color: rgba(0,0,0,0.18)
    box-shadow: 0 8px 20px rgba(0,0,0,0.10)
  &:focus-visible
    outline: 2px solid $accent
    outline-offset: 2px
  img
    display: block
    width: 100%
    height: auto // natural aspect ratio -- the whole point of this layout
    margin: 0

.pf-shot figcaption
  font-size: 13px
  color: $muted
  padding: 7px 2px 0

// -------------------------------------------- compact rows (side projects)
.pf-list
  list-style: none
  padding: 0
  margin: 0

.pf-row
  display: flex
  align-items: center
  gap: 16px
  padding: 14px 4px
  border-bottom: 1px solid $line
  transition: background-color .16s ease
  &:hover
    background: rgba(0,0,0,0.018)

// Deliberately small -- these are side projects, not headline work.
.pf-row-thumb
  flex: 0 0 auto
  width: 84px
  height: 48px
  border-radius: 3px
  overflow: hidden
  background: #f2f2f2
  display: flex
  align-items: center
  justify-content: center
  img
    width: 100%
    height: 100%
    margin: 0
    object-fit: cover
  // No cover at all: keep the row aligned without drawing a grey box.
  &.is-empty
    background: transparent
    border: 1px dashed rgba(0,0,0,0.11)

.pf-row-text
  flex: 1 1 auto
  min-width: 0

.pf-row-title
  display: block
  font-size: 15.5px
  font-weight: 600
  color: $ink

.pf-row-summary
  display: block
  font-size: 13px
  line-height: 1.5
  color: $muted
  margin-top: 2px

.pf-row-links
  flex: 0 0 auto
  display: flex
  gap: 12px
  a
    font-size: 13px
    color: $accent !important
    text-decoration: none !important
    white-space: nowrap
    &:hover
      text-decoration: underline !important


// --------------------------------------------------- writings / prose tail
.pf-prose
  h1, h2
    margin: 0 0 20px !important
    padding-bottom: 9px
    border-bottom: 1px solid $line
    font-size: 15px
    font-weight: 600
    letter-spacing: .09em
    text-transform: uppercase
    color: $muted

// --------------------------------------------------------------- lightbox
.pf-lightbox
  position: fixed
  top: 0
  left: 0
  width: 100%
  height: 100%
  z-index: 2000
  background: rgba(12,12,12,0.94)
  display: none
  align-items: center
  justify-content: center
  opacity: 0
  transition: opacity .2s ease
  &.is-open
    display: flex
  &.is-visible
    opacity: 1

.pf-lb-stage
  margin: 0
  max-width: 92vw
  max-height: 88vh
  display: flex
  flex-direction: column
  align-items: center
  img
    max-width: 92vw
    max-height: 80vh
    margin: 0
    object-fit: contain
    border-radius: 3px
  figcaption
    color: rgba(255,255,255,0.72)
    font-size: 14px
    margin-top: 14px
    text-align: center
    min-height: 20px

.pf-lb-close
.pf-lb-nav
  position: absolute
  background: transparent
  border: 0
  color: rgba(255,255,255,0.72)
  cursor: pointer
  transition: color .18s ease
  &:hover
    color: #fff
  &:focus-visible
    outline: 2px solid #fff
    outline-offset: 2px

.pf-lb-close
  top: 14px
  right: 22px
  font-size: 40px
  line-height: 1

.pf-lb-nav
  top: 50%
  margin-top: -28px
  font-size: 56px
  line-height: 1
  padding: 0 18px
  &.is-prev
    left: 4px
  &.is-next
    right: 4px
  &[hidden]
    display: none

// ------------------------------------------------------------- responsive
@media (max-width: 767px)
  .pf-grid
    grid-template-columns: 1fr
    gap: 20px
  .pf-gallery
    column-count: 2
    column-gap: 12px
  .pf-shot
    margin-bottom: 12px
  // Links drop under the text rather than squeezing the title.
  .pf-row
    flex-wrap: wrap
    gap: 12px
  .pf-row-links
    flex-basis: 100%
    padding-left: 96px
  .pf-card.is-featured
    grid-column: span 1
  .pf-filter
    gap: 6px
  .pf-chip
    font-size: 13px
    padding: 8px 13px
  .pf-lb-nav
    font-size: 40px
    padding: 0 10px

// Two columns is the most a tablet can show without the cards getting cramped.
@media (min-width: 768px) and (max-width: 991px)
  .pf-grid
    grid-template-columns: repeat(2, 1fr)
  .pf-gallery
    column-count: 2

@media (prefers-reduced-motion: reduce)
  .pf-card
  .pf-cover img
  .pf-lightbox
    transition: none !important
  .pf-card:hover
    transform: none
  .pf-card.pf-reveal
    opacity: 1
    transform: none
